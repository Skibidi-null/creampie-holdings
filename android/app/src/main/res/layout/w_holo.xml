<?xml version="1.0" encoding="utf-8"?>
<!-- One flexible HOLO layout for every widget; WidgetKit shows/hides parts by widget kind and size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_bg">
    <LinearLayout android:id="@+id/pad" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="13dp">
        <LinearLayout android:id="@+id/head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#A9ABC8" android:textSize="9.5sp" android:letterSpacing="0.2" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/corner" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6E7190" android:textSize="9.5sp" android:fontFamily="monospace" android:paddingStart="6dp" />
            <TextView android:id="@+id/edit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#9DF6FF" android:textSize="9.5sp" android:fontFamily="monospace" android:paddingStart="8dp" android:text="EDIT" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/mid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/gauge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:visibility="gone" android:scaleType="fitCenter" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F4F5FA" android:textSize="24sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3CFFB4" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitXY" android:visibility="gone" />
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/r0n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#E6E7F2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r0v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3CFFB4" android:textSize="12sp" android:fontFamily="monospace" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/r1n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#E6E7F2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r1v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3CFFB4" android:textSize="12sp" android:fontFamily="monospace" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/r2n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#E6E7F2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r2v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3CFFB4" android:textSize="12sp" android:fontFamily="monospace" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/r3n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#E6E7F2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r3v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3CFFB4" android:textSize="12sp" android:fontFamily="monospace" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/r4n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#E6E7F2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r4v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3CFFB4" android:textSize="12sp" android:fontFamily="monospace" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/r5n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#E6E7F2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r5v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3CFFB4" android:textSize="12sp" android:fontFamily="monospace" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row6" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/r6n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#E6E7F2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r6v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3CFFB4" android:textSize="12sp" android:fontFamily="monospace" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row7" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/r7n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#E6E7F2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r7v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3CFFB4" android:textSize="12sp" android:fontFamily="monospace" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row8" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/r8n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#E6E7F2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r8v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3CFFB4" android:textSize="12sp" android:fontFamily="monospace" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row9" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/r9n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#E6E7F2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r9v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3CFFB4" android:textSize="12sp" android:fontFamily="monospace" android:maxLines="1" />
        </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/foot" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#6E7190" android:textSize="9.5sp" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
